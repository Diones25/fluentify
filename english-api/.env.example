# Banco de dados (docker-compose expõe 5433 no host)
DATABASE_URL="postgresql://app:app@localhost:5433/english?schema=public"

# Autenticação
JWT_SECRET=""
GOOGLE_CLIENT_ID=""

# IA
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
OPENAI_MODEL_FAST="gpt-4.1-mini"
AI_DAILY_TOKEN_ALERT=""

# Infra
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
NODE_ENV=development

# Frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# Observabilidade
SENTRY_DSN=""

# E-mail (recuperação de senha)
RESEND_API_KEY=""
MAIL_FROM="English Talk <no-reply@seudominio.com>"

# Dashboard de filas (Bull Board em /queues)
DASHBOARD_USER=admin
DASHBOARD_PASS=admin
