generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Level {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum Goal {
  TRAVEL
  WORK
  CONVERSATION
  EXAMS
}

enum AudioMode {
  ALWAYS
  SPEAKING_ONLY
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum LessonType {
  SPEAKING
  VOCAB
  CHAT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String?
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  profile       Profile?
  plans         StudyPlan[]
  conversations Conversation[]
  attempts      Attempt[]
  streak        Streak?
  aiUsage AiUsage[]
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  reviewCards ReviewCard[]
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique
  level         Level
  goal          Goal
  minutesPerDay Int
  daysPerWeek   Int
  audioMode     AudioMode @default(ALWAYS)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id        String     @id @default(uuid())
  userId    String
  status    PlanStatus @default(ACTIVE)
  weeks     Int
  promptVersion Int    @default(1)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      PlanDay[]
}

model PlanDay {
  id          String    @id @default(uuid())
  planId      String
  dayNumber   Int
  theme       String
  completedAt DateTime?
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([planId, dayNumber])
}

model Lesson {
  id        String     @id @default(uuid())
  planDayId String
  type      LessonType
  order     Int
  content   Json
  planDay   PlanDay    @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  attempts  Attempt[]
}

model Attempt {
  id         String   @id @default(uuid())
  userId     String
  lessonId   String?
  expected   String
  transcript String
  score      Int
  feedback   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  topic     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  analysis       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Streak {
  userId        String  @id
  current       Int     @default(0)
  best          Int     @default(0)
  lastActiveDay String? // "YYYY-MM-DD"
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiUsage {
  id           String @id @default(uuid())
  userId       String
  day          String // "YYYY-MM-DD" (UTC)
  feature      String // "tutor" | "plan" | "tip" | "analysis" | "mission"
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  calls        Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, feature])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // guardamos só o hash, nunca o token puro
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewCard {
  id        String   @id @default(uuid())
  userId    String
  front     String   // o que o aluno vê (ex.: "table")
  back      String   // a resposta (ex.: "mesa")
  ease      Float    @default(2.5)  // "facilidade" do cartão
  interval  Int      @default(0)    // dias até a próxima revisão
  reps      Int      @default(0)    // acertos seguidos
  dueAt     DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, front]) // evita cartão duplicado
  @@index([userId, dueAt])
}
